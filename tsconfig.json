{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "lib": ["ES2018", "DOM"],
    "jsx": "react",
    "declaration": true,
    "declarationDir": "./types",
    "outDir": "./transpiled",
    "rootDir": ".",
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "transpiled"]
}
